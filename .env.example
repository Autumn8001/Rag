# 云端大模型配置 (默认支持 OpenAI 兼容格式，如使用智谱 GLM 则填入智谱 API 密钥)
OPENAI_API_KEY="your_api_key_here"
BASE_URL="https://open.bigmodel.cn/api/paas/v4"
FLASH_MODEL="glm-4-flash"
STANDARD_MODEL="glm-4"
PLUS_MODEL="glm-4-plus"
EMBEDDING_MODEL="embedding-3"

# 私有化本地模型部署切换示例 (如本地部署的 vLLM, Ollama, Xinference 等 OpenAI 兼容端点)
# OPENAI_API_KEY="local_dummy_key"
# BASE_URL="http://localhost:8000/v1"
# FLASH_MODEL="local-fast-model"
# STANDARD_MODEL="local-chat-model"
# PLUS_MODEL="local-chat-model"
# EMBEDDING_MODEL="local-embedding-model"

# 数据库连接配置 (默认支持 SQLite，生产/多租户隔离环境推荐使用 PostgreSQL)
# 默认推荐本地开发直接使用 SQLite：
DATABASE_URL="sqlite:///./data/enterprise_rag.db"
# PostgreSQL 本地开发示例：DATABASE_URL="postgresql://postgres:postgres@localhost:5435/enterprise_rag"

# LangSmith 链路追踪可观测性配置 (用于流程及问答效果的可视化 Trace 展示)
# LANGCHAIN_TRACING_V2=true
# LANGCHAIN_ENDPOINT="https://api.smith.langchain.com"
# LANGCHAIN_API_KEY="your_langsmith_api_key_here"
# LANGCHAIN_PROJECT="enterprise-rag"

# JWT 统一认证配置 (两项目共享以实现单点登录 SSO)
JWT_SECRET_KEY="your_super_secret_jwt_key_here"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440
