# 云端大模型配置 (默认支持 OpenAI 兼容格式，如使用智谱 GLM 则填入智谱 API 密钥)
OPENAI_API_KEY="your_api_key_here"
BASE_URL="https://open.bigmodel.cn/api/paas/v4"

# 私有化本地模型部署切换示例 (如本地部署的 vLLM, Ollama, Xinference 等 OpenAI 兼容端点)
# OPENAI_API_KEY="local_dummy_key"
# BASE_URL="http://localhost:8000/v1"

# 数据库连接配置 (默认支持 SQLite，生产/多租户隔离环境推荐使用 PostgreSQL)
# PostgreSQL 本地开发示例：DATABASE_URL="postgresql://postgres:postgres@localhost:5432/enterprise_rag"
# SQLite 本地开发示例：DATABASE_URL="sqlite:///./data/enterprise_rag.db"

# LangSmith 链路追踪可观测性配置 (用于流程及问答效果的可视化 Trace 展示)
# LANGCHAIN_TRACING_V2=true
# LANGCHAIN_ENDPOINT="https://api.smith.langchain.com"
# LANGCHAIN_API_KEY="your_langsmith_api_key_here"
# LANGCHAIN_PROJECT="enterprise-rag"
